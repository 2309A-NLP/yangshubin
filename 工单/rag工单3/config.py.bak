def ensure_dirs():
    """确保所有输出目录存在"""
    for d in [OUTPUT_DIR, MINERU_OUTPUT_DIR, TEMPLATES_DIR]:
        os.makedirs(d, exist_ok=True)


def log(msg: str, tag: str = "INFO"):
    """带时间戳的日志输出"""
    from datetime import datetime
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{ts}] [{tag}] {msg}")


def is_windows():
    return sys.platform == "win32"
